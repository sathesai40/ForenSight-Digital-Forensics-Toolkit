# ForenSight - Digital Forensics Investigation Toolkit
# Version Control Exclusion Rules

# Environment variables & secrets
.env
.env.local
.env.*.local
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# SQLite databases & storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite*
*.db-*
*.bak
*.backup
*.dump
*.sql
data/
backend/data/

# Forensic evidence vaults & stored copies (Security & Chain of Custody)
vault/
evidence/
backend/vault/
backend/evidence/
backend/storage/evidence/
uploads/

# Generated reports & exports
reports/
backend/reports/
exports/
*.pdf
*.csv.export

# Python virtual environments & bytecode
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.pyd
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node.js & Frontend dependencies/build
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
*.tsbuildinfo

# IDE & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/
backend/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local publication audit outputs and temporary verification files
.publication-audit/
*.tmp
*.temp
*.orig
*.rej
*.zip
*.7z
*.tar
*.gz
