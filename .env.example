# ForenSight - Digital Forensics Investigation Toolkit
# Environment Configuration Template (SAFE PLACEHOLDERS ONLY)
# Copy this file to .env before starting services

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Forensic Storage & Vault Paths (relative to backend or absolute)
EVIDENCE_VAULT_DIR=./data/vault
REPORTS_DIR=./data/reports
SQLITE_DB_PATH=./data/forensight.db

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://127.0.0.1:8000/api
